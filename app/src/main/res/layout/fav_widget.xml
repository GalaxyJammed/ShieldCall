<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fav_widget_bg"
    android:padding="8dp">

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="Tap to choose favorites"
        android:textColor="@color/fav_text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/row0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/tile0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/fav_tile_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/avatar0"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/name0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/fav_text"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/tile1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/fav_tile_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/avatar1"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/name1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/fav_text"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/tile2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/fav_tile_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/avatar2"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/name2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/fav_text"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/tile3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/fav_tile_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/avatar3"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/name3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/fav_text"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/tile4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/fav_tile_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/avatar4"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/name4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/fav_text"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/tile5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/fav_tile_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/avatar5"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/name5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/fav_text"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
